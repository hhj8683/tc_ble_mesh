{
  "module": {
    "name": "TelinkSigMeshDemo",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "TelinkSigMeshDemoAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "TelinkSigMeshDemoAbility",
        "srcEntry": "./ets/abilities/TelinkSigMeshDemoAbility.ets",
        "description": "$string:TelinkSigMeshDemoAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:TelinkSigMeshDemoAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "TelinkSigMeshDemoBackupAbility",
        "srcEntry": "./ets/backupabilities/TelinkSigMeshDemoBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name" : "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:ble_permission_reason",
        "usedScene": {
          "abilities": [
            "FormAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name" : "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:reason_permission_read_doc",
        "usedScene": {
          "abilities": [
            "FormAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name" : "ohos.permission.READ_MEDIA",
        "reason": "$string:reason_permission_read_doc",
        "usedScene": {
          "abilities": [
            "FormAbility"
          ],
          "when":"inuse"
        }
      }
    ]
  }
}