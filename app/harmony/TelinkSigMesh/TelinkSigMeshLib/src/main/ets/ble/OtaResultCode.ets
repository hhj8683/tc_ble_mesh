export interface OtaResult {
  code: number
  description: string
}

export class OtaResultCode {
  /**
   * success
   */
  static OTA_SUCCESS: OtaResult = { code: 0x00, description: "success" }
  /***************************************************************
   * fail codes and info
   ***************************************************************/
  static OTA_DATA_PACKET_SEQ_ERR: OtaResult =
    { code: 0x01, description: "OTA data packet sequence number error: repeated OTA PDU or lost some OTA PDU" }
  static OTA_PACKET_INVALID: OtaResult = {
    code: 0x02,
    description: "invalid OTA packet: 1. invalid OTA command; 2. addr_index out of range; 3.not standard OTA PDU length"
  }
  static OTA_DATA_CRC_ERR: OtaResult = { code: 0x03, description: "packet PDU CRC err" }
  static OTA_WRITE_FLASH_ERR: OtaResult = { code: 0x04, description: "write OTA data to flash ERR" }
  static OTA_DATA_INCOMPLETE: OtaResult = { code: 0x05, description: "lost last one or more OTA PDU" }
  static OTA_FLOW_ERR: OtaResult =
    { code: 0x06, description: "peer device send OTA command or OTA data not in correct flow" }
  static OTA_FW_CHECK_ERR: OtaResult = { code: 0x07, description: "firmware CRC check error" }
  static OTA_VERSION_COMPARE_ERR: OtaResult =
    { code: 0x08, description: "the version number to be update is lower than the current version" }
  static OTA_PDU_LEN_ERR: OtaResult = {
    code: 0x09,
    description: "PDU length error: not 16*n, or not equal to the value it declare in \"CMD_OTA_START_EXT\" packet"
  }
  static OTA_FIRMWARE_MARK_ERR: OtaResult =
    { code: 0x0a, description: "firmware mark error: not generated by telink's BLE SDK" }
  static OTA_FW_SIZE_ERR: OtaResult =
    { code: 0x0b, description: "firmware size error: no firmware_size; firmware size too small or too big" }
  static OTA_DATA_PACKET_TIMEOUT: OtaResult = {
    code: 0x0c,
    description: "time interval between two consequent packet exceed a value(user can adjust this value)"
  }
  static OTA_TIMEOUT: OtaResult = { code: 0x0d, description: "OTA flow total timeout" }
  static OTA_FAIL_DUE_TO_CONNECTION_TERMINATE: OtaResult = {
    code: 0x0e,
    description: "OTA fail due to current connection terminate(maybe connection timeout or local/peer device terminate connection)"
  }
  /* only secure boot mode involved form 0x80 */
  static OTA_SECBOOT_HW_ERR: OtaResult = { code: 0x80, description: "OTA server device hardware error" }
  static OTA_SECBOOT_SYSTEM_ERR: OtaResult = { code: 0x81, description: "OTA server device system error" }
  static OTA_SECBOOT_FUNC_NOT_ENABLE: OtaResult =
    { code: 0x82, description: "OTA server device do not enable secure boot function" }
  static OTA_SECBOOT_PUBKEY_SIGN_SEQ_ERR: OtaResult =
    { code: 0x83, description: "OTA public key & signature sequence number error: repeated or lost" }
  static OTA_SECBOOT_PUBKEY_SIGN_LEN_ERR: OtaResult =
    { code: 0x84, description: "OTA public key & signature data packet length error" }
  static OTA_SECBOOT_PUBLIC_KEY_ERR: OtaResult =
    { code: 0x85, description: "OTA client public key not match OTA server device local hash" }
  static OTA_SECBOOT_SIGN_VERIFY_FAIL: OtaResult = { code: 0x86, description: "OTA signature verification fail" }
  static OTA_SECBOOT_WRITE_DESC_FAIL: OtaResult = { code: 0x87, description: "write secure boot descriptor fail" }
  static OTA_SECBOOT_NEW_FW_NOT_MATCH_OLD_FW: OtaResult =
    { code: 0x88, description: "secure boot function: new firmware not match old firmware" }
  static OTA_FWENC_NEW_FW_NOT_MATCH_OLD_FW: OtaResult =
    { code: 0x89, description: "firmware encryption function: new firmware not match old firmware" }
  static UNKNOWN_CODE: OtaResult = { code: 0xFF, description: "unknown code" }
  static ALL: Array<OtaResult> = [
  /**
   * success
   */
    OtaResultCode.OTA_SUCCESS,

    /***************************************************************
     * fail codes and info
     ***************************************************************/
    OtaResultCode.OTA_DATA_PACKET_SEQ_ERR,

    OtaResultCode.OTA_PACKET_INVALID,

    OtaResultCode.OTA_DATA_CRC_ERR,

    OtaResultCode.OTA_WRITE_FLASH_ERR,

    OtaResultCode.OTA_DATA_INCOMPLETE,

    OtaResultCode.OTA_FLOW_ERR,

    OtaResultCode.OTA_FW_CHECK_ERR,

    OtaResultCode.OTA_VERSION_COMPARE_ERR,

    OtaResultCode.OTA_PDU_LEN_ERR,

    OtaResultCode.OTA_FIRMWARE_MARK_ERR,

    OtaResultCode.OTA_FW_SIZE_ERR,

    OtaResultCode.OTA_DATA_PACKET_TIMEOUT,

    OtaResultCode.OTA_TIMEOUT,

    OtaResultCode.OTA_FAIL_DUE_TO_CONNECTION_TERMINATE,


    /* only secure boot mode involved form 0x80 */
    OtaResultCode.OTA_SECBOOT_HW_ERR,

    OtaResultCode.OTA_SECBOOT_SYSTEM_ERR,

    OtaResultCode.OTA_SECBOOT_FUNC_NOT_ENABLE,

    OtaResultCode.OTA_SECBOOT_PUBKEY_SIGN_SEQ_ERR,

    OtaResultCode.OTA_SECBOOT_PUBKEY_SIGN_LEN_ERR,

    OtaResultCode.OTA_SECBOOT_PUBLIC_KEY_ERR,

    OtaResultCode.OTA_SECBOOT_SIGN_VERIFY_FAIL,

    OtaResultCode.OTA_SECBOOT_WRITE_DESC_FAIL,

    OtaResultCode.OTA_SECBOOT_NEW_FW_NOT_MATCH_OLD_FW,

    OtaResultCode.OTA_FWENC_NEW_FW_NOT_MATCH_OLD_FW,


    OtaResultCode.UNKNOWN_CODE,
  ]

  public static getResultCode(code: number): OtaResult | undefined {
    return OtaResultCode.ALL.find((item) => {
      return code == item.code
    })
  }

  public static getDescription(result: OtaResult): string {
    if (result == OtaResultCode.OTA_SUCCESS) {
      return "OTA success";
    }
    return `OTA result: ${result.code} - ${result.description}`;
  }
}
