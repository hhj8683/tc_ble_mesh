export interface MeshKey {
    keyIndex: number
    key: Uint8Array
}

export interface DeviceKey {
    address: number
    key: Uint8Array
}

/**
 * Generates a random byte array of the specified length.
 *
 * @param length The length of the byte array to generate.
 * @return A randomly generated byte array.
 */
export function generateRandom(length: number): Uint8Array {
    return cryptoFramework.createRandom().generateRandomSync(length).data
}

/**
 * This code is a method that returns the current TAI (International Atomic Time) time in seconds.
 */
export function getTaiTime() {
    return new Date().getTime() / 1000 - TAI_OFFSET_SECOND
}


export function currentTimeMillis() {
    return new Date().getTime()
}

export function bit(n: number) {
    return 1 << n;
}


/**
 * Converts a sequence number to a byte array buffer.
 *
 * @param sequenceNumber the sequence number to be converted
 * @return the byte array buffer representing the sequence number
 */
export function sequenceNumber2Buffer(sequenceNumber: number): Uint8Array {
    return num2bytes(sequenceNumber, 3, ByteOrder.BIG_ENDIAN);
}

/**
 * generate Aid (Application Identifier)
 *
 * @param key key
 * @return result
 */
export function generateAid(key: Uint8Array): number {
    return k4(key);
}

/**
 * This method returns the size of the Message Integrity Code (MIC) based on the given byte value.
 *
 * @return mic size
 */
export function getMicSize(szmic: number) {
    return szmic == 0 ? 4 : 8;
}

/**
 * Checks if the given address is a valid unicast address.
 *
 * @param address the address to be checked
 * @return true if the address is valid, false otherwise
 */
export function validUnicastAddress(address: number): boolean {
    return (address & 0xFFFF) <= ADDRESS_UNICAST_MAX && (address & 0xFFFF) >= ADDRESS_UNICAST_MIN;
}

/**
 * Checks whether the given address is a valid group address.
 * A group address is considered valid if the lower 16 bits of the address are between 0xC000 and 0xFEFF (inclusive).
 *
 * @param address the address to be checked
 * @return true if the address is a valid group address, false otherwise
 */
export function validGroupAddress(address: number): boolean {
    return (address & 0xFFFF) < 0xFF00 && (address & 0xFFFF) >= 0xC000;
}

/**
 * This method calculates the logarithm base 2 of a given number.
 *
 * @param i input
 * @return result
 */
export function mathLog2(i: number) {
    return Math.log(i) / Math.log(2);
}

/**
 * This method compares two integers in an unsigned manner.
 *
 * @param a unsigned number
 * @param b unsigned number
 * @return result
 */
export function unsignedIntegerCompare(a: number, b: number) {
    return (a & UNSIGNED_INTEGER_MAX) - (b & UNSIGNED_INTEGER_MAX);
}

/**
 * converts a hexadecimal string to an integer using big-endian byte order.
 *
 * @param hex input
 * @return int value
 * big endian
 */
export function hexToIntB(hex: string): number {
    return parseInt(hex, 16)
}

/**
 * Converts an integer value to its hexadecimal representation.
 *
 * @param value the integer value to be converted
 * @return the hexadecimal representation of the given value
 */
export function intToHex(value: Number): string {
    if (value <= 0xFF) {
        return value.toString(16).padStart(2, '0')
    } else if (value <= 0xFFFF) {
        return value.toString(16).padStart(4, '0')
    } else if (value <= 0xFFFFFF) {
        return value.toString(16).padStart(6, '0')
    } else {
        return value.toString(16).padStart(8, '0')
    }

}

/**
 * Converts an integer value to a hexadecimal string representation.
 * The length parameter specifies the number of bytes the value should be formatted to.
 * Returns the hexadecimal string representation of the value.
 */
export function intToHexWithLen(value: number, length: number) {
    if (length == 1) {
        return value.toString(16).padStart(2, '0')
    } else if (length == 2) {
        return value.toString(16).padStart(4, '0')
    } else if (length == 3) {
        return value.toString(16).padStart(6, '0')
    } else {
        return value.toString(16).padStart(8, '0')
    }
}

/**
 * iterates through each element in the list and checks if the current element is equal to the target string, ignoring case sensitivity.
 *
 * @param list   string list
 * @param target target string
 * @return whether list contains the target
 */
export function hexListContains(list: Array<string>, target: string): boolean {
    for (let s of list) {
        if (s.toLowerCase() === target.toLowerCase()) {
            return true;
        }
    }
    return false;
}

/**
 * iterates through each element in the list and checks if the current element is equal to the target integer, ignoring case sensitivity.
 *
 * @param list   string list
 * @param target target int
 * @return whether list contains the target
 */
export function hexListContainsNumber(list: Array<string>, target: number): boolean {
    let i: number
    for (let s of list) {
        i = hexToIntB(s)
        if (i == target) {
            return true;
        }
    }
    return false;
}


/**
 * get missing bit position
 */
export function parseMissingBitField(params: Uint8Array, offset: number): Array<number> {
    let missingChunks = new Array<number>()
    let BYTE_LEN = 8
    let val: number
    for (let basePosition = 0; offset < params.length; offset++, basePosition += BYTE_LEN) {
        val = params[offset];
        for (let i = 0; i < BYTE_LEN; i++) {
            let missing = ((val >> i) & 0b01) == 1;
            if (missing) {
                missingChunks.push(basePosition + i);
            }
        }
    }
    return missingChunks;
}


/**
 * @return is certificate based supported
 */
export function isCertSupported(oobInfo: number): boolean {
    return (oobInfo & bit(7)) != 0;
}

/**
 * @return is provisioning record supported
 */
export function isPvRecordSupported(oobInfo: number): boolean {
    return (oobInfo & bit(8)) != 0;
}

/**
 * Converts a string representation of a UUID to a byte array.
 *
 * @param uuid the string representation of the UUID
 * @return the byte array representation of the UUID
 */
export function uuidToByteArray(uuid: string): Uint8Array {
    const cleanUuid = uuid.replace(/-/g, '').toLowerCase();
    const result = new Uint8Array(16)
    for (let i = 0; i < 16; i++) {
        const byteStr = cleanUuid.substr(i * 2, 2);
        result[i] = parseInt(byteStr, 16);
    }

    return result;
}

export function uuidToRawHex(uuid: string): string {
    const cleanUuid = uuid.replace(/-/g, '').toLowerCase();
    return cleanUuid;
}


/**
 * aggregates multiple mesh messages into a single byte array.
 *
 * @param elementAddress specifies the address of the element to which the messages belong.
 * @param meshMessages   list of MeshMessage objects containing the messages to be aggregated.
 * @return a byte array containing the aggregated messages.
 */
export function aggregateMessages(elementAddress: number, meshMessages: ArrayList<MeshMessage>): Uint8Array {
    let result = num2bytes(elementAddress, 2, ByteOrder.LITTLE_ENDIAN);
    let len: number;
    let isLong: boolean;
    let bufLen: number;
    let accessPdu: Uint8Array;
    for (let msg of meshMessages) {
        accessPdu = new AccessLayerPDU(msg.getOpcode(), msg.getParams()).toByteArray();
        len = accessPdu.length;
        isLong = len > 127;
        bufLen = (isLong ? 2 : 1) + len + result.length;
        let buffer = new Uint8Array(bufLen)
        let offset = 0
        buffer.set(result, offset)
        offset += result.length
        len <<= 1 | (isLong ? 1 : 0);
        if (isLong) {
            buffer.set(num2bytes(len, 2), offset)
            offset += 2
        } else {
            buffer[offset] = len
            offset += 1
        }
        buffer.set(accessPdu, offset)
        result = buffer
    }
    return result;
}

/**
 * This method parses the OpcodeAggregatorStatusMessage and returns a list of StatusMessage objects.
 *
 * @param opAggStsMsg The OpcodeAggregatorStatusMessage to be parsed.
 * @return A list of StatusMessage objects generated from the OpcodeAggregatorStatusMessage.
 * Returns null if the statusItems list is empty or null.
 */
export function parseOpcodeAggregatorStatus(opAggStsMsg: OpcodeAggregatorStatusMessage): ArrayList<StatusMessage> | undefined {
    let items = opAggStsMsg.statusItems;
    if (items.length == 0) {
        return undefined;
    }
    let msgList: ArrayList<StatusMessage> = new ArrayList();
    let msg: StatusMessage | undefined;
    for (let item of items) {
        msg = MeshStatus.getStatusMessage(item.opcode, item.parameters);
        if (msg) {
            msgList.add(msg);
        }
    }
    return msgList;
}

/**
 * @param start
 * @param len
 * @return ByteOrder.LITTLE_ENDIAN
 */
export function getUnicastRange(start: number, len: number): Uint8Array {
    if (len == 1) {
        return num2bytes(start << 1, 2, ByteOrder.LITTLE_ENDIAN);
    } else {
        let sVal = ((start << 1) | 0x01)
        return new Uint8Array([sVal, sVal >> 8, len])
    }
}

export function isUuid(input: string) {
    const uuidRegex: RegExp = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
    return uuidRegex.test(input);
}
